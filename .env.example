# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used only by `supabase db push`/`gen types` and admin/test scripts — never
# read by the running app. Use the Transaction pooler connection string if
# the direct host is IPv6-only and unreachable from your network.
SUPABASE_DB_URL=

# App
APP_URL=http://localhost:3000

# AI providers (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-5
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
GOOGLE_AI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# The model a request uses when it does not pick its own. See
# BUILD-NOTES-NEXTJS.md's Task 22 live-benchmark finding for why Haiku 4.5
# was chosen over Sonnet 5 (Sonnet reproducibly failed the prompt-injection
# scenario outright; Haiku had zero unsupported claims across all six
# scenarios and never failed).
PRODUCTION_AI_PROVIDER=anthropic
PRODUCTION_AI_MODEL=claude_haiku_4_5

# Research/retrieval provider
FIRECRAWL_API_KEY=
