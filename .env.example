# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
APP_URL=http://localhost:3000

# AI providers (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-5
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
GOOGLE_AI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# Production model selection (used when ENABLE_AI_TEST_MODE=false)
PRODUCTION_AI_PROVIDER=anthropic
PRODUCTION_AI_MODEL=claude_sonnet_5

# Research/retrieval provider
FIRECRAWL_API_KEY=

# Discord notification webhooks (best-effort, optional)
DISCORD_CONTENT_WEBHOOK_URL=
DISCORD_REVIEW_WEBHOOK_URL=
DISCORD_ERRORS_WEBHOOK_URL=

# Development / test mode toggles (must be false/unset in production)
ENABLE_AI_TEST_MODE=true
USE_FAKE_PROVIDERS=false
ENABLE_FAILURE_INJECTION=false
TEST_FAILURE_TOKEN=

# Seeded test accounts (local/test only, never commit real credentials)
TEST_CONTENT_MANAGER_EMAIL=
TEST_CONTENT_MANAGER_PASSWORD=
TEST_REVIEWER_EMAIL=
TEST_REVIEWER_PASSWORD=

# Supabase project id (used by `supabase gen types` and admin scripts)
SUPABASE_PROJECT_ID=
