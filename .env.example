# Public application URL used by auth email redirects in production.
# Example: https://content-app-nine-fawn.vercel.app
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used only by `supabase db push`/`gen types` and admin/test scripts — never
# read by the running app. Use the Transaction pooler connection string if
# the direct host is IPv6-only and unreachable from your network.
SUPABASE_DB_URL=

# AI model (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Research/retrieval provider
FIRECRAWL_API_KEY=
